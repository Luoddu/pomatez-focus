{
  "name": "root",
  "private": true,
  "version": "1.11.0",
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "commit": "git-cz",
    "dev:renderer": "lerna run dev:renderer --stream",
    "dev:main": "lerna run dev:main --stream",
    "dev:tauri": "lerna run dev:renderer --stream",
    "dev:app": "cross-env ELECTRON_ENABLE_LOGGING=1 lerna run start --parallel --stream",
    "prebuild": "lerna run prepare --stream",
    "lerna": "lerna",
    "build": "lerna run build --parallel --stream",
    "build:mwl": "yarn build && lerna run build:mwl --stream",
    "build:dir": "yarn build && lerna run build:dir --stream",
    "build:win": "yarn build && lerna run build:win --stream",
    "build:mac": "yarn build && lerna run build:mac --stream",
    "build:linux": "yarn build && lerna run build:linux --stream",
    "build:snap": "yarn build && lerna run build:snap --stream",
    "build:tauri": "yarn tauri build",
    "build:updaterfile": "node app/tauri/release-prep/release-prep.js",
    "release:mw": "yarn build && lerna run release:mw --stream",
    "release": "yarn build && lerna run release --stream",
    "clean": "lerna exec -- rimraf build/ dist/",
    "gen:tts": "lerna run gen:tts --stream",
    "format": "prettier --write .",
    "tauri": "cd app/tauri && tauri",
    "tauri:dev": "yarn tauri dev",
    "tauri:dev-with-updater": "yarn tauri dev --config ./release.conf.json",
    "tauri:updateversion": "node ./app/tauri/util/cargo-version-updater.js",
    "build:focus": "node scripts/build-focus.cjs",
    "test:focus": "node --test tests/session.test.mjs tests/feishu.test.cjs tests/plan.test.cjs",
    "test:desktop": "node scripts/test-desktop.cjs && node scripts/test-portrait-desktop.cjs && node scripts/test-category-review-desktop.cjs",
    "test:quick-entry": "node scripts/test-quick-entry.cjs",
    "package:focus": "node scripts/package-focus.cjs",
    "check:sync": "node scripts/repo-sync.cjs",
    "version:prepare": "node scripts/next-version.cjs --bump",
    "push:focus": "node scripts/push-focus.cjs",
    "dev:setup": "node scripts/dev-setup.cjs",
    "test:sync": "node --test tests/repo-sync.test.cjs",
    "test:focus:all": "node scripts/test-focus-all.cjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "commitizen": "^4.1.2",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^1.2.0",
    "husky": "^4.3.8",
    "lerna": "^7.3.0",
    "lint-staged": "^10.5.4",
    "prettier": "2.7.1",
    "rimraf": "^3.0.2",
    "rollup": "^2.79.1",
    "rollup-plugin-typescript2": "^0.27.3",
    "typescript": "4.9.4",
    "wait-on": "7.0.1"
  },
  "resolutions": {
    "@types/react": "^16.9.46",
    "@types/react-dom": "^16.9.19",
    "react-error-overlay": "6.0.9",
    "@parcel/watcher": "2.5.6"
  },
  "packageManager": "yarn@1.22.22"
}
