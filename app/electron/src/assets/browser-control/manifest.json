{
  "manifest_version": 3,
  "name": "番茄农场 · 科学专注",
  "version": "1.1.0",
  "description": "由本机农场控制B站和小红书的暂停与冷静期；不读取Cookie或上传浏览记录。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.xiaohongshu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.xiaohongshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
